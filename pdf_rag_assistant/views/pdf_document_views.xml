<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PDF Document Form View -->
    <record id="view_pdf_document_form" model="ir.ui.view">
        <field name="name">pdf.document.form</field>
        <field name="model">pdf.document</field>
        <field name="arch" type="xml">
            <form string="PDF Document">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_qa_sessions" icon="fa-question-circle">
                            <field string="QA Sessions" name="qa_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="pdf_filename" invisible="1"/>
                            <field name="pdf_file" filename="pdf_filename"/>
                        </group>
                        <group>
                            <button name="process_pdf" string="submit" type="object" class="btn-primary"/>

                            <field name="status" invisible="1" readonly="1"/>
                            <field name="create_date" readonly="1" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ask Question" invisible="status != 'ready'">
                            <group>
                                <field name="question_input" nolabel="1" placeholder="Enter your question here..." widget="text"/>
                                <button string="Ask Question" type="object" name="action_ask_question" class="btn-primary"/>
                            </group>
                        </page>
                        <page string="Content">
                            <field name="text_content" readonly="1" widget="text"/>
                        </page>
                        <page string="Error Details" invisible="status != 'error'">
                            <field name="error_message" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- PDF Document list View -->
    <record id="view_pdf_document_list" model="ir.ui.view">
        <field name="name">pdf.document.list</field>
        <field name="model">pdf.document</field>
        <field name="arch" type="xml">
            <list string="PDF Documents">
                <field name="pdf_filename"/>
                <field name="status"/>
                <field name="qa_count"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- PDF Document Action -->
    <record id="action_pdf_document" model="ir.actions.act_window">
        <field name="name">PDF Documents</field>
        <field name="res_model">pdf.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload your first PDF document!
            </p>
            <p>
                Upload PDF documents and ask questions about their content using AI.
            </p>
        </field>
    </record>

    <record id="view_qa_answer_wizard_form" model="ir.ui.view">
        <field name="name">qa.answer.wizard.form</field>
        <field name="model">qa.answer.wizard</field>
        <field name="arch" type="xml">
            <form string="Answer">
                <group>
                    <field name="question" widget="text"/>
                </group>
                <separator string="Answer"/>
                <group>
                    <field name="answer" widget="text"/>
                </group>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
