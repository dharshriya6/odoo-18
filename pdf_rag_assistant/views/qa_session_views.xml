<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Q&A Session list View -->
    <record id="view_qa_session_list" model="ir.ui.view">
        <field name="name">qa.session.list</field>
        <field name="model">qa.session</field>
        <field name="arch" type="xml">
            <list string="QA Sessions">
                <field name="document_id"/>
                <field name="question"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Q&A Session Form View -->
    <record id="view_qa_session_form" model="ir.ui.view">
        <field name="name">qa.session.form</field>
        <field name="model">qa.session</field>
        <field name="arch" type="xml">
            <form string="QA Session">
                <sheet>
                    <group>
                        <field name="document_id"/>
                        <field name="create_date"/>
                    </group>
                    <group string="Question">
                        <field name="question" nolabel="1" widget="text"/>
                    </group>
                    <group string="Answer">
                        <field name="answer" nolabel="1" widget="text"/>
                    </group>
                    <group string="Context Used" groups="base.group_no_one">
                        <field name="context" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Q&A Session Action -->
    <record id="action_qa_session" model="ir.actions.act_window">
        <field name="name">QA Sessions</field>
        <field name="res_model">qa.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>